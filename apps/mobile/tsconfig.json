{
  "extends": ["../../tsconfig.base.json"],
  "compilerOptions": {
    "outDir": "dist",
    "strict": true,
    "jsx": "react-native",
    "lib": ["esnext"],
    "allowJs": true,
    "composite": true,
    "noEmit": false,
    "paths": {
      "@/*": ["./*"],
      "@shared/*": ["../../packages/*/src"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}

{
  "name": "sdprimer",
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "private": true,
  "scripts": {
    "lint:mobile": "yarn workspace sdprimer_mobile lint",
    "lint:staged": "eslint --cache --fix apps/web packages --ext .ts,.tsx,.js,.jsx",
    "dev:ios": "yarn workspace sdprimer_mobile start",
    "dev:android": "yarn workspace sdprimer_mobile start",
    "dev:web": "yarn workspace sdprimer_web start",
    "build:ios": "cd apps/mobile && npx expo run:ios --no-install",
    "build:android": "cd apps/mobile && npx expo run:android --no-install",
    "build:web": "yarn workspace sdprimer_web build",
    "build:constants": "yarn workspace @shared/constants run build",
    "build:localization": "yarn workspace @shared/localization run build",
    "build:packages": "concurrently \"yarn build:constants\" \"yarn build:localization\" ",
    "install:all": "yarn install && yarn build:packages",
    "clean": "rm -rf  node_modules packages/*/dist packages/*/tsconfig.tsbuildinfo",
    "test": "TZ=UTC  jest --config jest.config.js --selectProjects mobile-ios mobile-android web-app",
    "test:ci": "TZ=UTC  jest --config jest.config.js --runInBand",
    "test:coverage": "jest --config jest.config.js --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "expo": "^54.0.8",
    "lodash": "^4.17.21",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.79.2",
    "tsc": "^2.0.4",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4",
    "@types/node": "^24.5.2",
    "@types/react": "19.0.0",
    "@types/react-test-renderer": "19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.32.0",
    "@yarnpkg/pnpify": "^4.1.4",
    "concurrently": "^9.2.1",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-import-resolver-node": "^0.3.9",
    "eslint-import-resolver-typescript": "^4.3.4",
    "eslint-plugin-check-file": "^3.3.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-unicorn": "^59.0.1",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "jest": "^30.1.3",
    "jest-expo": "^54.0.11",
    "prettier": "^3.6.2",
    "react-test-renderer": "19.0.0",
    "ts-node": "^10.9.2"
  },
  "nohoist": [
    "packages/*",
    "apps/*"
  ],
  "packageManager": "yarn@4.14.1",
  "repository": "git@github.com:SDPrimer/apps.git",
  "author": "Amit Raikwar <raikwar.amit.1603@gmail.com>",
  "license": "MIT",
  "resolutions": {
    "eslint-config-expo/eslint-import-resolver-typescript": "^4.3.4"
  }
}
